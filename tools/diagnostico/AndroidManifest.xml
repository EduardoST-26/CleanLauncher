<?xml version="1.0" encoding="utf-8"?>
<!-- Read-only diagnostics for the head unit. targetSdk 22 so permissions are granted at install
     (no runtime dialogs) and the report can be written to the pendrive. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.eduardost.diagnostico"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />

    <application
        android:label="Diagnóstico Radio"
        android:icon="@android:drawable/ic_menu_info_details"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
